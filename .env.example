# --- PostgreSQL (requerido) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis_user
POSTGRES_PASSWORD=your_password_here

# --- Proveedores LLM (cascada Groq -> NVIDIA -> Ollama) ---
# Sin GROQ/NVIDIA la cascada cae al Ollama local. Ollama no necesita clave.
GROQ_API_KEY=your_key_here
NVIDIA_API_KEY=your_key_here
# Kimi/Moonshot: fallback de contexto grande (enabled:false en providers.json)
KIMI_API_KEY=

# --- Auth interna (generar con: python -c "import secrets; print(secrets.token_urlsafe(32))") ---
JARVIS_API_KEY=change_me   # protege la API :3000 (header X-Jarvis-Key)
RELAY_API_KEY=change_me    # protege el relay de Figaro

# --- Integraciones ---
GARMIN_EMAIL=
GARMIN_PASSWORD=
FIGARO_SSH_KEY=            # ruta a la clave SSH sin passphrase para auditoria remota

# --- Overrides opcionales (defaults en config/settings.py) ---
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# MODEL=qwen2.5:7b
# TIMEOUT=120
