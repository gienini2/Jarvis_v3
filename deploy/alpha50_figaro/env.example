# /opt/alpha50/.env en Figaro (lo genera migrar_desde_pc.ps1; chmod 600)

# Garmin Connect (las mismas del .env del PC)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Telegram via el relay de este mismo servidor
RELAY_URL=http://127.0.0.1:10004
RELAY_API_KEY=

# API de Alpha50: la usan el relay (mensajes /alpha50) y el PC (historial)
ALPHA50_API_KEY=
ALPHA50_BIND=100.78.43.76
ALPHA50_PORT=10050

# Hora del brief matutino (hora de Espana, ver TZ en alpha50.service)
ALPHA50_HORA=07:00
